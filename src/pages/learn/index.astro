---
import Base from "../../layouts/Base.astro";

const sourceCommit = "7dea87828cd25f572c3444e4a205b8f012d02e60";
const sourceShort = sourceCommit.slice(0, 12);
const repo = "https://github.com/casablanca-labs/proofnote";
const source = `${repo}/tree/${sourceCommit}`;
const browserVerifier = "/verify/browser/";
const browserArtifactSha256 = "22ad37979c666e39f9f0ee6567b00901b315e155918ae46fc5cf059e45b8a95a";

const startCommands = `git clone https://github.com/casablanca-labs/proofnote.git
cd proofnote
git checkout ${sourceCommit}
node examples/01-verify-a-proof/run.mjs`;

const tamperCommands = `node examples/01-verify-a-proof/run.mjs --tamper-settlement
node examples/conformance.mjs
node verify.mjs list
node verify.mjs explain verify-a-proof`;

const verifyPrompt = `Audit the released verifier.

Work only from a clean clone of casablanca-labs/proofnote at commit ${sourceCommit}.

Preflight: require Node.js >=20.6.0, confirm HEAD equals the commit, and confirm the checkout is clean.

1. Read examples/01-verify-a-proof/README.md and example.json.
2. Run node examples/01-verify-a-proof/run.mjs; require exit 0.
3. Run node examples/01-verify-a-proof/run.mjs --tamper-settlement; require exit 3 and PAIRING_REJECTED.
4. Run node examples/conformance.mjs, node verify.mjs list, and node verify.mjs explain verify-a-proof.
5. Report the exact evidence identities, positive result, negative result, and every stated non-claim.

Use no private repository or network. Do not claim CashVM execution, BCH validation or inclusion, wallet acceptance, spendability, privacy, or successive transfer.`;

const cashVmPrompt = `Build a local settlement-authorization CashVM example.

Start from casablanca-labs/proofnote commit ${sourceCommit} in a new branch.

This task is explicitly authorized to add only @bitauth/libauth@3.1.0-next.8 and its deterministic pnpm-lock.yaml closure (npm integrity sha512-Pm+Ju+YP3JeBLLTiVrBnia2wwE4G17r4XqpvPRMcklElJTe8J6x3JgKRg1by0Xm3ZY6UFxACkEAoSA+x419/zA==). Do not add, remove, or upgrade any other dependency. The example must execute with network access denied after installation.

Target: examples/06-simulate-settlement-authorization-cashvm. Examples 02 through 05 are reserved by the released developer journey. Do not edit released evidence.

1. Inventory the published public transition vectors, CashAssembly sources, and settlement-authorization bytecode fixture.
2. Reconstruct a deterministic synthetic unsigned transaction and its source outputs solely from a declared public vector. Record every input digest.
3. Evaluate the covenant with createVirtualMachineBch2026(false), Libauth's BCH_2026_05 consensus instruction set. Report createVirtualMachineBch2026(true) standard-policy evaluation separately.
4. Add a passing case plus deterministic tampering of the projection commitment, one source output, and locking bytecode. Print byte size, VM profile, verdict, raw VM error or top-stack state, and the application-level reason for each failure.
5. Add README, runner, expected output, example.json, and a conformance entry. Require pnpm install --frozen-lockfile and deny network during conformance.

This establishes only local CashVM evaluation of the frozen settlement-projection covenant over a synthetic public fixture. It does not establish Groth16 execution in CashVM, chain inclusion, funding, signing, wallet acceptance, privacy, or successive-owner transfer. Never fund, sign, or broadcast.`;

const chipnetPrompt = `Prepare a Chipnet operator packet template.

Start only after a reviewed, released local CashVM example exists. Name its immutable public commit, example ID, and evidence digest at the top of the report.

1. Re-run the released local positive and negative controls from the pinned commit.
2. Record the exact synthetic transaction bytes and every boundary that makes them non-broadcastable.
3. Produce a checklist separating operator-selected tBCH source outputs, funding authorization, private-key access, signing, pre-broadcast review, broadcast, and fresh chain attestation.
4. State all public metadata and linkage surfaces a real broadcast would expose.
5. Add no wallet integration, UTXO lookup, funding, signing, or network call.

Return a reviewable operator packet template, not a claim that a Chipnet transaction was prepared, signed, relayed, accepted, or confirmed.`;

const stages = [
  {
    number: "01",
    state: "RUNNABLE",
    stateClass: "pass",
    title: "Verify a released proof in this browser",
    body: "The self-contained verifier performs the complete BN254 pairing over the released V4 proof, pinned key, and public values without a clone, package, wallet, or backend verifier.",
    href: "#browser-lab",
    link: "Open the browser lab",
  },
  {
    number: "02",
    state: "RUNNABLE NEGATIVE",
    stateClass: "pass",
    title: "Break one binding",
    body: "Change public values, proof bytes, key bytes, or the selector and see the exact boundary reject—still entirely in the browser.",
    href: "#browser-lab",
    link: "Run a tamper case",
  },
  {
    number: "03",
    state: "RUNNABLE",
    stateClass: "pass",
    title: "Audit the public repository",
    body: "Pin the immutable release commit, reproduce the verifier from Node.js, run conformance, and inspect every evidence identity and non-claim.",
    href: "#run-it",
    link: "Use the clean-clone path",
  },
  {
    number: "04",
    state: "PLANNED LAB",
    stateClass: "pending",
    title: "Simulate the transaction in CashVM",
    body: "The feasibility spike passes today; the next public example will pin Libauth and make the settlement-projection covenant falsifiable over a synthetic unsigned transaction.",
    href: "#cashvm-lab",
    link: "Use the CashVM build prompt",
  },
  {
    number: "05",
    state: "OPERATOR GATE",
    stateClass: "pending",
    title: "Promote the local artifact to Chipnet",
    body: "Prepare an unsigned continuation first. Funding, signing, broadcast, and chain attestation remain separate human-authorized steps.",
    href: "#chipnet",
    link: "Prepare the Chipnet packet",
  },
];
---

<Base
  title="Learn Proofnote — verify, simulate, and prepare for Chipnet"
  description="Run a real Proofnote verifier, make it fail, then progress from local CashVM simulation toward an explicitly authorized Chipnet transaction."
>
  <section class="learn-hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Learn / developer workshop</span>
        <h1>Run a real proof.<br />Break it.<br />Then build toward BCH.</h1>
      </div>
      <div class="hero-note">
        <p>
          Proofnote is easiest to understand as an execution sequence, not a
          whitepaper. Start with released bytes and a falsifiable result. Move
          into CashVM locally. Touch Chipnet only after the transaction and its
          privacy residue are reviewable.
        </p>
        <a class="source-link mono" href={source}>
          immutable source {sourceShort}… ↗
        </a>
      </div>
    </div>
  </section>

  <section class="wrap ladder" aria-labelledby="ladder-title">
    <div class="section-head">
      <div>
        <span class="eyebrow">Execution ladder</span>
        <h2 id="ladder-title">Five boundaries. Three are runnable today.</h2>
      </div>
      <p class="muted">
        State labels are part of the claim. Planned work never borrows a green
        badge from the released verifier.
      </p>
    </div>

    <ol class="stage-list">
      {stages.map((stage) => (
        <li class="stage">
          <span class="stage-number mono">{stage.number}</span>
          <div class="stage-copy">
            <span class={`state ${stage.stateClass} mono`}>{stage.state}</span>
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
          </div>
          <a href={stage.href} class="stage-link mono">{stage.link} →</a>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap browser-lab" id="browser-lab" aria-labelledby="browser-title">
    <div class="browser-intro">
      <div>
        <span class="eyebrow">Run here / zero install</span>
        <h2 id="browser-title">The proof verifier is already loaded.</h2>
      </div>
      <div>
        <p class="muted">
          Choose the published proof or a tamper case. Your browser performs
          the complete BN254 pairing locally. The artifact requests no
          packages, wallet access, network data, or backend verification.
        </p>
        <div class="browser-actions">
          <a class="browser-button mono" href={browserVerifier}>Open full-screen verifier →</a>
          <a class="text-link mono" href={`${source}/browser-verifier/proofnote-browser-verifier.html`}>
            inspect released HTML ↗
          </a>
        </div>
        <p class="artifact-id mono">sha256 {browserArtifactSha256}</p>
      </div>
    </div>
    <div class="browser-frame-shell">
      <div class="browser-frame-head">
        <span class="mono">local browser / released artifact</span>
        <span class="state pass mono">OFFLINE</span>
      </div>
      <iframe
        src={browserVerifier}
        title="Proofnote released proof verifier"
        loading="eager"
        sandbox="allow-scripts"
      ></iframe>
      <noscript>
        <p class="no-script">
          JavaScript is off. <a href={browserVerifier}>Open the verifier</a> to read its
          evidence identities and no-JavaScript explanation.
        </p>
      </noscript>
    </div>
  </section>

  <section class="wrap lab" id="run-it" aria-labelledby="run-title">
    <div class="lab-copy">
      <span class="eyebrow">Run now</span>
      <h2 id="run-title">A real PASS, from a clean clone.</h2>
      <p class="muted">
        No install is required for example 01. The runner uses only the
        published fixture, verification key, and Node.js built-ins.
      </p>
      <a href={`${source}/examples/01-verify-a-proof/README.md`} class="text-link mono">
        Read the exact example contract ↗
      </a>
    </div>
    <div class="terminal" data-copy-source="start-commands">
      <div class="terminal-head">
        <span class="mono">local / proof</span>
        <button type="button" data-copy="start-commands">Copy</button>
      </div>
      <pre id="start-commands"><code>{startCommands}</code></pre>
      <p class="expected"><span class="state pass mono">EXPECTED</span> exit 0 · pairing verified</p>
    </div>
  </section>

  <section class="wrap lab reverse" id="tamper" aria-labelledby="tamper-title">
    <div class="lab-copy">
      <span class="eyebrow">Falsify it</span>
      <h2 id="tamper-title">The useful demo is the one that can fail.</h2>
      <p class="muted">
        The tamper preserves valid curve-point encodings while changing a
        committed settlement value. Arithmetic binding—not a parser
        shortcut—rejects it.
      </p>
    </div>
    <div class="terminal" data-copy-source="tamper-commands">
      <div class="terminal-head">
        <span class="mono">local / negative controls</span>
        <button type="button" data-copy="tamper-commands">Copy</button>
      </div>
      <pre id="tamper-commands"><code>{tamperCommands}</code></pre>
      <p class="expected"><span class="state fail mono">EXPECTED</span> PAIRING_REJECTED · exit 3</p>
    </div>
  </section>

  <section class="agent-section" aria-labelledby="agents-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Agentic interface</span>
          <h2 id="agents-title">Delegate the mechanics. Keep the authority boundaries.</h2>
        </div>
        <p class="muted">
          These prompts are work contracts. They identify the source, demand
          negative controls, and stop before secrets or network mutation.
        </p>
      </div>

      <div class="prompt-grid">
        <article class="prompt-card">
          <div class="prompt-head">
            <span class="state pass mono">RUNNABLE</span>
            <button type="button" data-copy="verify-prompt">Copy prompt</button>
          </div>
          <h3>Audit the released verifier</h3>
          <pre id="verify-prompt"><code>{verifyPrompt}</code></pre>
        </article>

        <article class="prompt-card" id="cashvm-lab">
          <div class="prompt-head">
            <span class="state pending mono">PLANNED LAB</span>
            <button type="button" data-copy="cashvm-prompt">Copy prompt</button>
          </div>
          <h3>Build the Libauth CashVM example</h3>
          <p class="prompt-limit">
            No reviewed runner is released yet. This prompt defines the next
            example contract; it does not display invented VM output.
          </p>
          <pre id="cashvm-prompt"><code>{cashVmPrompt}</code></pre>
        </article>

        <article class="prompt-card" id="chipnet">
          <div class="prompt-head">
            <span class="state pending mono">OPERATOR GATE</span>
            <button type="button" data-copy="chipnet-prompt">Copy prompt</button>
          </div>
          <h3>Prepare a Chipnet continuation</h3>
          <p class="prompt-limit">
            Construction can be automated. tBCH funding, signing, broadcast,
            and post-broadcast attestation remain separate approvals.
          </p>
          <pre id="chipnet-prompt"><code>{chipnetPrompt}</code></pre>
        </article>
      </div>
    </div>
  </section>

  <section class="wrap boundary" aria-labelledby="boundary-title">
    <div>
      <span class="eyebrow">Current R&D boundary</span>
      <h2 id="boundary-title">Successive private transfer is not a tutorial yet.</h2>
    </div>
    <div>
      <p>
        Bob → Charles remains blocked until host, Rust, SP1, proof,
        authenticated CashVM verifier, settlement, chain, and recipient
        acceptance evidence agree. The public repository carries the blocker
        as a machine-readable example instead of a runnable-looking substitute.
      </p>
      <a href={`${source}/examples/05-successive-owner-transfer/README.md`} class="text-link mono">
        Inspect all eight blockers ↗
      </a>
    </div>
  </section>

  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        const target = document.getElementById(button.dataset.copy ?? "");
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.textContent ?? "");
          const prior = button.textContent;
          button.textContent = "Copied";
          setTimeout(() => (button.textContent = prior), 1400);
        } catch {
          const selection = window.getSelection();
          const range = document.createRange();
          range.selectNodeContents(target);
          selection?.removeAllRanges();
          selection?.addRange(range);
          button.textContent = "Select text";
        }
      });
    }
  </script>
</Base>

<style>
  .learn-hero {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(3rem, 8vw, 6rem);
    border-bottom: 1px solid var(--rule);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: end;
  }

  .learn-hero h1 {
    max-width: 22ch;
    font-size: clamp(2.15rem, 5.2vw, 4.5rem);
    line-height: 1.06;
  }

  .hero-note {
    border-left: 1px solid var(--rule-hi);
    padding-left: 1.5rem;
  }

  .hero-note p {
    color: var(--muted);
  }

  .source-link,
  .text-link {
    color: var(--pass);
    font-size: 0.75rem;
  }

  .ladder,
  .browser-lab,
  .lab,
  .boundary {
    padding-top: clamp(3.5rem, 8vw, 6rem);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.55fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-head p {
    margin: 0;
  }

  .stage-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-hi);
  }

  .stage {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .stage-number {
    color: var(--dim);
    font-size: 0.75rem;
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .state::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }

  .state.pass { color: var(--pass); }
  .state.pending { color: var(--pending); }
  .state.fail { color: var(--fail); }

  .stage h3 {
    margin-top: 0.55rem;
  }

  .stage p {
    margin: 0.45rem 0 0;
    color: var(--muted);
    max-width: 62ch;
    font-size: 0.9rem;
  }

  .stage-link {
    color: var(--muted);
    font-size: 0.72rem;
    text-align: right;
  }

  .stage-link:hover { color: var(--text); }

  .browser-lab {
    display: grid;
    gap: 2rem;
  }

  .browser-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1.15fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
  }

  .browser-intro p { margin-top: 0; }

  .browser-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    align-items: center;
  }

  .browser-button {
    display: inline-flex;
    padding: 0.75rem 1rem;
    border: 1px solid var(--pass);
    color: var(--text);
    background: color-mix(in srgb, var(--pass) 10%, transparent);
    font-size: 0.72rem;
  }

  .browser-button:hover { background: color-mix(in srgb, var(--pass) 18%, transparent); }
  .browser-button:focus-visible { outline: 2px solid var(--pass); outline-offset: 3px; }

  .artifact-id {
    margin: 1rem 0 0 !important;
    color: var(--dim);
    font-size: 0.65rem;
    overflow-wrap: anywhere;
  }

  .browser-frame-shell {
    overflow: hidden;
    border: 1px solid var(--rule-hi);
    background: var(--surface);
  }

  .browser-frame-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.7rem;
  }

  .browser-frame-shell iframe {
    display: block;
    width: 100%;
    min-height: 50rem;
    border: 0;
    background: #090b0f;
  }

  .no-script {
    margin: 0;
    padding: 1rem;
    color: var(--muted);
  }

  .lab {
    display: grid;
    grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .lab > * {
    min-width: 0;
  }

  .lab.reverse .lab-copy { order: 2; }

  .terminal,
  .prompt-card {
    border: 1px solid var(--rule-hi);
    background: var(--surface);
  }

  .terminal-head,
  .prompt-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.7rem;
  }

  button {
    appearance: none;
    border: 1px solid var(--rule-hi);
    background: transparent;
    color: var(--text);
    font: 0.68rem var(--mono);
    padding: 0.35rem 0.6rem;
    cursor: pointer;
  }

  button:hover { border-color: var(--pass); }
  button:focus-visible { outline: 2px solid var(--pass); outline-offset: 3px; }

  .terminal pre,
  .prompt-card pre {
    margin: 0;
    border: 0;
    border-left: 0;
    background: transparent !important;
  }

  .expected {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.75rem;
  }

  .agent-section {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-block: 1px solid var(--rule);
    background: var(--surface);
  }

  .prompt-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .prompt-card {
    min-width: 0;
    border: 0;
    background: var(--bg);
  }

  .prompt-card h3 {
    padding: 1.25rem 1rem 0;
  }

  .prompt-card pre {
    max-height: 30rem;
    white-space: pre-wrap;
  }

  .prompt-limit {
    padding: 0 1rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .boundary {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding-bottom: 1rem;
  }

  .boundary p { color: var(--muted); }

  @media (max-width: 58rem) {
    .hero-grid,
    .section-head,
    .browser-intro,
    .lab,
    .boundary {
      grid-template-columns: minmax(0, 1fr);
    }

    .lab.reverse .lab-copy { order: initial; }
    .prompt-grid { grid-template-columns: 1fr; }
    .browser-frame-shell iframe { min-height: 58rem; }
  }

  @media (max-width: 42rem) {
    .stage {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .stage-link {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
